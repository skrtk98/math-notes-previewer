    "renderer.js",
    "THIRD_PARTY_LICENSES.md"
  ],
  "dependencies": {
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "markdown-it-deflist": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-texmath": "^1.0.0"
  }
}
